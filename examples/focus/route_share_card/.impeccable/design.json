      "html": "<button class=\"ds-selected-mode\" aria-pressed=\"true\">安静</button>",
      "css": ".ds-selected-mode{min-height:48px;padding:10px 18px;border:1px solid #F2D229;border-radius:0;background:#F2D229;color:#171B1D;font:800 14px system-ui,sans-serif}.ds-selected-mode:hover{background:#FFE251}.ds-selected-mode:active{transform:translateY(1px)}.ds-selected-mode:focus-visible{outline:3px solid #FFF9E8;outline-offset:3px}"
    },
