      "css": ".ds-manifest-row{display:flex;gap:18px;padding:18px;border:0;border-radius:0;background:#FFF9E8;color:#171B1D}.ds-manifest-number{display:grid;place-items:center;width:50px;height:50px;flex:none;background:#1747D1;color:#fff;font:900 19px monospace}.ds-manifest-row h3{margin:0 0 7px;font:900 25px/1.05 system-ui,sans-serif}.ds-manifest-row p{margin:0 0 10px;color:#4B514F;font:15px/1.45 system-ui,sans-serif}.ds-manifest-row code{color:#1747D1;font:900 14px monospace}.ds-manifest-row:hover{background:#F2E9CC}.ds-manifest-row:focus-within{outline:3px solid #F2D229;outline-offset:3px}"
