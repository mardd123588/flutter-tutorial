      "css": ".ds-cue-stop{display:flex;align-items:flex-start;gap:12px;min-height:48px;color:#171B1D;font:16px system-ui,sans-serif}.ds-stop-number{display:grid;place-items:center;width:28px;height:28px;background:#F2D229;color:#171B1D;font:900 14px monospace}.ds-stop-start{margin-left:auto;padding:5px 8px;background:#F2D229;color:#171B1D;font:900 13px system-ui,sans-serif}.ds-cue-stop:focus-within{outline:3px solid #1747D1;outline-offset:3px}"
    },
