      "html": "<label class=\"ds-start-wrap\"><span>自定义起点</span><input class=\"ds-start-field\" value=\"旧仓库入口\"></label>",
      "css": ".ds-start-wrap{display:grid;gap:8px;color:#fff;font:800 14px system-ui,sans-serif}.ds-start-field{min-height:48px;padding:0 14px;border:1px solid #171B1D;border-radius:0;background:#FFF9E8;color:#171B1D;font:16px system-ui,sans-serif}.ds-start-field:hover{border-color:#F2D229}.ds-start-field:focus-visible{outline:3px solid #F2D229;outline-offset:2px}"
    },
